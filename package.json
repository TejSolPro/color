{
  "name": "color-by-tej-solpro",
  "private": true,
  "version": "0.0.0",
  "description": "Open-source color intelligence for AI-built interfaces.",
  "license": "MPL-2.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --recursive build",
    "build:docs": "pnpm --filter @tejsolpro/color build && cp packages/core/dist/index.js docs/playground/color-core.js",
    "test": "pnpm --recursive test",
    "typecheck": "pnpm --filter @tejsolpro/color build && pnpm --recursive typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
